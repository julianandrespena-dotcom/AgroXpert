# Servidor
PORT=3000

# Microsoft Fabric - base de datos de usuarios y permisos
FABRIC_SERVER=servidor_sql_de_fabric
FABRIC_DATABASE=AgroXpert_Usuarios

# Microsoft Fabric - datos agrícolas del dashboard
FABRIC_AGRICOLA_SERVER=servidor_sql_de_datos_agricolas
FABRIC_AGRICOLA_DATABASE=nombre_base_datos_agricola

# Microsoft Entra ID - identidad de la aplicación
ENTRA_TENANT_ID=id_directorio_tenant
ENTRA_CLIENT_ID=id_aplicacion_cliente
ENTRA_CLIENT_SECRET=secreto_aplicacion

# Validación de identidad corporativa
ENTRA_AUDIENCE=audiencia_aplicacion

# Administrador de AgroXpert
ADMIN_USERNAME=usuario_administrador
ADMIN_PASSWORD_HASH=hash_contrasena_administrador

# Usuarios de prueba
ENABLE_TEST_USERS=false